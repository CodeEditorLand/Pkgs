{
    "name": "@swc/cli",
    "version": "0.7.7",
    "description": "CLI for the swc project",
    "main": "lib/swc/index.js",
    "scripts": {
        "prepublishOnly": "pnpm build",
        "types": "tsc",
        "types:watch": "tsc --watch",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "format:src": "prettier --write src",
        "format:examples": "prettier --write examples",
        "format": "pnpm format:src && pnpm format:examples",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "JEST_COVERAGE=true jest --coverage"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/swc-project/pkgs.git"
    },
    "keywords": [
        "swc",
        "cli",
        "babel",
        "es6",
        "transpile",
        "transpiler",
        "compiler",
        "javascript"
    ],
    "author": "강동윤 <kdy1997.dev@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/swc-project/pkgs/issues"
    },
    "homepage": "https://github.com/swc-project/pkgs",
    "engines": {
        "node": ">= 16.14.0"
    },
    "bin": {
        "swc": "./bin/swc.js",
        "swcx": "./bin/swcx.js",
        "spack": "./bin/spack.js"
    },
    "dependencies": {
        "@swc/counter": "workspace:^",
        "@xhmikosr/bin-wrapper": "^13.0.5",
        "commander": "^14.0.0",
        "minimatch": "^10.0.1",
        "piscina": "^5.0.0",
        "semver": "^7.7.2",
        "slash": "5.1.0",
        "source-map": "^0.7.4",
        "tinyglobby": "^0.2.14"
    },
    "devDependencies": {
        "@swc/cli": "0.7.7",
        "@swc/core": "^1.11.31",
        "@swc/jest": "workspace:^",
        "@swc/types": "^0.1.22",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.0.0",
        "@types/semver": "^7.7.0",
        "chokidar": "^4.0.3",
        "deepmerge": "^4.3.1",
        "jest": "^30.0.0",
        "ts-jest": "^29.3.4",
        "typescript": "~5.8.3"
    },
    "peerDependencies": {
        "@swc/core": "^1.11.31",
        "chokidar": "^4.0.3"
    },
    "peerDependenciesMeta": {
        "chokidar": {
            "optional": true
        }
    },
    "files": [
        "bin",
        "lib"
    ]
