{
	"name": "@codeeditorland/cli",
	"version": "0.0.1",
	"private": false,
	"description": "CLI for the swc project",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Pkgs#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Pkgs/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Pkgs.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"main": "lib/swc/index.js",
	"bin": {
		"spack": "./bin/spack.js",
		"swc": "./bin/swc.js",
		"swcx": "./bin/swcx.js"
	},
	"files": [
		"bin",
		"lib"
	],
	"scripts": {
		"build": "swc src --strip-leading-paths -d lib --ignore '**/*.test.ts' --ignore '**/__mocks__/**'",
		"build:watch": "swc src --strip-leading-paths -d lib --watch --ignore '**/*.test.ts' --ignore '**/__mocks__/**'",
		"format:examples": "prettier --write examples",
		"format:src": "prettier --write src",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"test:coverage": "JEST_COVERAGE=true jest --coverage",
		"test:watch": "jest --watch",
		"types": "tsc",
		"types:watch": "tsc --watch"
	},
	"dependencies": {
		"@codeeditorland/counter": "workspace:^",
		"@xhmikosr/bin-wrapper": "13.0.5",
		"commander": "13.1.0",
		"fast-glob": "3.3.3",
		"minimatch": "10.0.1",
		"piscina": "4.9.2",
		"semver": "7.7.1",
		"slash": "5.1.0",
		"source-map": "0.7.4"
	},
	"devDependencies": {
		"@codeeditorland/cli": "0.7.1",
		"@codeeditorland/core": "1.6.4",
		"@codeeditorland/jest": "workspace:^",
		"@codeeditorland/types": "0.1.9",
		"@playform/build": "0.2.1",
		"@types/node": "22.14.0",
		"@types/semver": "7.7.0",
		"chokidar": "4.0.3",
		"deepmerge": "4.3.1"
	},
	"peerDependenciesMeta": {
		"chokidar": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
